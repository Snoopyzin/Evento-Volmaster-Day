bower_components/

# Arquivos de build (se houver)
dist/
build/

# Backups e arquivos temporários
*.bak
*.backup
*-old.*
*-backup.*
*-novo.*
*-temp.*
*.tmp

# Arquivos de configuração local
.env
.env.local
config.local.js


# Auto detect text files and perform LF normalization
* text=auto

# Source code
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Images
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text eol=lf

# Fonts
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary

# Archives
*.zip binary
*.tar binary
*.gz binary
*.rar binary

# Documents
*.pdf binary

# Export ignore (arquivos que não devem ser incluídos em releases)
.gitattributes export-ignore
.gitignore export-ignore
.github export-ignore
*.md export-ignore
CHANGELOG.md -export-ignore
README.md -export-ignore
LICENSE.md -export-ignore

# Linguist overrides (estatísticas do GitHub)
*.css linguist-vendored=false
*.js linguist-vendored=false
docs/* linguist-documentation
*.md linguist-documentation

# Diff configuration
*.html diff=html
*.css diff=css
*.js diff=javascript
